meta {
  name: Get Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("has id and role", function() {
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body).to.have.property("role");
  });
}
