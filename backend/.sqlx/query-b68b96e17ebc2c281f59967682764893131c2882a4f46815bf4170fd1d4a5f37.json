  "query": "SELECT l.id, l.name, l.path, l.created_at\n               FROM libraries l\n               JOIN library_permissions lp ON lp.library_id = l.id\n               WHERE lp.user_id = $1 AND lp.can_read = true\n               ORDER BY l.created_at",
