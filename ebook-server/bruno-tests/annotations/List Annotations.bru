meta {
  name: List Annotations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/books/{{bookId}}/annotations
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("should return array", function() {
    expect(res.getBody()).to.be.an('array');
  });
}

docs {
  List all annotations for a book (current user only), ordered by page ASC.
}
