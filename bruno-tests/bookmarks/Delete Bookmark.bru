meta {
  name: Delete Bookmark
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/bookmarks/{{bookmarkId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("should return 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Delete a bookmark by ID. Only the owner can delete.
  Set `bookmarkId` in environment before running.
}
