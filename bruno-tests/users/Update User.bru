meta {
  name: Update User
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "role": "guest"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("role changed to guest", function() {
    expect(res.getBody().role).to.equal("guest");
  });
}
