meta {
  name: Get Library
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/libraries/{{libraryId}}
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("should return library details", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body).to.have.property("name");
    expect(body).to.have.property("path");
  });
}
