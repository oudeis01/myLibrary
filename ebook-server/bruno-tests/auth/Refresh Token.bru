meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/refresh
  auth: none
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body.access_token) {
    bru.setEnvVar("authToken", body.access_token);
  }
}

tests {
  test("should return new access_token", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("access_token");
  });
}

docs {
  Refresh the access token using the refresh_token cookie (automatically sent by Bruno). Run Login first to get the cookie set.
}
