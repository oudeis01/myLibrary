# PostgreSQL
DB_PASSWORD=change_me_strong_password

# JWT — 최소 32자 랜덤 문자열 (openssl rand -base64 32)
JWT_SECRET=change_me_min_32_chars_random_string_here

# 개발 환경 (docker-compose.dev.yml 사용 시)
DATABASE_URL=postgres://ebook:devpassword@localhost:5432/ebook
# BOOKS_PATH / THUMBS_PATH: 절대경로 권장
# 상대경로를 쓰면 cargo run 실행 위치(backend/)를 기준으로 해석됨
BOOKS_PATH=/절대경로/data/books
THUMBS_PATH=/절대경로/data/thumbs
SERVER_PORT=3001
RUST_LOG=debug
